# Copy to .env (it is not committed). docker compose reads SEED_PASSWORD from there
# and refuses to start without it. Local pilot only: do not reuse this password.
DATABASE_URL=postgres://ibuild:ibuild@localhost:5433/ibuild?sslmode=disable
HOST=0.0.0.0
PORT=8080
SEED_ON_START=true
SEED_PASSWORD=123456
WEB_ROOT=../app/build/web
COOKIE_SECURE=false
MIGRATIONS_DIR=migrations
