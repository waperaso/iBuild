# Copy to .env.prod (never commit it) and fill every value.
# Do not commit .env.prod or the secret files below.
DOMAIN=ibuild.example.uz
# One source for each secret: the variable or a file path, never both.
# A file is mounted into the container and is not copied into its environment.
#   umask 077 && openssl rand -base64 24 > /srv/ibuild/db_password
DB_PASSWORD=
# DB_PASSWORD_FILE=/srv/ibuild/db_password
APP_VERSION=1
# Leave empty. Set only to override the URL the API builds from DB_PASSWORD.
DATABASE_URL=
# Key that seals letters in the database: openssl rand -base64 32
# Keep a copy outside the server. Without it the letters cannot be read.
MAIL_KEY=
# MAIL_KEY_FILE=/srv/ibuild/mail_key
# Mail (optional). Without SMTP_HOST letters wait in the queue (admin: Почта).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# SMTP_PASSWORD_FILE=/srv/ibuild/smtp_password
SMTP_FROM=iBuild <no-reply@ibuild.example.uz>
SMTP_SSL=false
# Read-only demo (role buttons on the sign-in page, isolated demo companies). Off by default.
DEMO_ENABLED=false
